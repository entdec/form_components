<h1 class="mb-6 text-2xl font-semibold text-gray-900 auto-dark:text-white">An Action Text attribute</h1>

<%= form_with model: @article, builder: FormComponents::FormBuilder, class: "space-y-6" do |f| %>
  <%= f.text_field :title %>
  <%= f.rich_text_area :content, toolbar: %i[heading | bold italic link | bullet_list ordered_list | align_left align_center | image] %>
  <%= f.submit %>
<% end %>

<% if @article.persisted? %>
  <h2 class="mt-10 mb-2 font-semibold text-gray-900 auto-dark:text-white">Stored</h2>
  <pre class="overflow-x-auto rounded bg-white p-4 text-xs auto-dark:bg-gray-800 auto-dark:text-gray-100" id="stored"><%= @article.content.body&.to_html %></pre>
  <h2 class="mt-10 mb-2 font-semibold text-gray-900 auto-dark:text-white">Rendered</h2>
  <div id="rendered" class="text-gray-900 auto-dark:text-white"><%= @article.content %></div>
<% end %>
