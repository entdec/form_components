<!DOCTYPE html>
<html>
  <head>
    <title>Form components</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%# Tailwind in the browser, for trying things out; a host builds it (see the README) %>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.1.11"></script>
    <style type="text/tailwindcss">
      @custom-variant auto-dark (@media (prefers-color-scheme: dark));
      @theme {
        --color-primary-50: rgb(232, 250, 244); --color-primary-100: rgb(215, 246, 236); --color-primary-300: rgb(158, 232, 208);
        --color-primary-500: rgb(100, 218, 180); --color-primary-600: rgb(48, 204, 153); --color-primary-700: rgb(35, 150, 113);
      }
      /* The select arrow and checkmark of @tailwindcss/forms, which a host has (see the README); the browser build can't load plugins */
      select:not([multiple]) {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
        background-position: right 0.5rem center;
        background-repeat: no-repeat;
        background-size: 1.5em 1.5em;
        appearance: none;
      }
      [type="checkbox"]:checked {
        background-image: url("data:image/svg+xml,%3csvg viewBox='0 0 16 16' fill='white' xmlns='http://www.w3.org/2000/svg'%3e%3cpath d='M12.207 4.793a1 1 0 010 1.414l-5 5a1 1 0 01-1.414 0l-2-2a1 1 0 011.414-1.414L6.5 9.086l4.293-4.293a1 1 0 011.414 0z'/%3e%3c/svg%3e");
        background-size: 100% 100%;
        background-position: center;
        background-repeat: no-repeat;
      }
    </style>
    <%= stylesheet_link_tag "form_components/jscolorpicker/colorpicker", "form_components/color_field/component", "hotwire_combobox" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50 auto-dark:bg-gray-900">
    <main class="mx-auto max-w-2xl p-8"><%= yield %></main>
  </body>
</html>
