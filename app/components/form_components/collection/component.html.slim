fieldset.form-component aria-describedby=aria_described_by
  - if label != false
    legend class=legend_classes = legend
  - if description.present?
    p id=tag_id+"_description" class=class_names("text-sm/6 text-gray-500 auto-dark:text-gray-400", "mt-1" => label != false) = description
  div class=class_names(items_classes, "mt-2" => label != false || description.present?)
    = items
  = after_items
  - if has_error?
    p id=tag_id+"_error" class="mt-2 text-sm text-red-600 auto-dark:text-red-400" = all_errors.join(", ")
