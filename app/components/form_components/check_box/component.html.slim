.form-component.flex.gap-3
  .flex.h-6.shrink-0.items-center
    .group.grid.size-4.grid-cols-1
      = input
  .text-sm/6
    - if label != false
      div.flex.justify-between
        = field_label(input_id, value: (checked_value if html_options[:multiple]))
    - if description.present?
      label for=input_id class="text-gray-500 auto-dark:text-gray-400" id=input_id+"_description"
        = description
    - if has_error?
      p id=input_id+"_error" class="mt-2 text-sm text-red-600 auto-dark:text-red-400" = all_errors.join(", ")
