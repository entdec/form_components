- if label != false
  = render FormComponents::Label::Component.new(form, object, method, label.presence)
.form-color-field.mt-2 class=class_names("form-color-field--error" => has_error?, "form-color-field--default" => default_color) style=(default_color && "--color-field-default: #{default_color}") data-controller="form-components--color-field" data-form-components--color-field-swatches-value=swatches.to_json
  input[id=tag_id
        type="text"
        name=name
        value=value
        placeholder=placeholder_text
        data-form-components--color-field-target="input"
        aria-invalid=aria_invalid
        aria-describedby=aria_described_by
        *options_for_input_html]
- if description.present?
  p id=tag_id+"_description" class="mt-2 text-sm text-gray-500 auto-dark:text-gray-400" = description
- if has_error?
  p id=tag_id+"_error" class="mt-2 text-sm text-red-600 auto-dark:text-red-400" = all_errors.join(", ")
