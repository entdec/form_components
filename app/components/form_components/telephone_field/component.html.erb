<div class="form-component">
  <% if label != false || corner_hint.present? %>
    <div class="flex justify-between">
      <%= field_label %>
      <span class="text-sm/6 text-gray-500 auto-dark:text-gray-400"><%= corner_hint %></span>
    </div>
  <% end %>
  <%= tag.div class: "relative mt-2", data: {controller: "form-components--telephone-field", "form-components--telephone-field-countries-value": countries.to_json, "form-components--telephone-field-priority-value": priority_countries.to_json, "form-components--telephone-field-country-value": selected_country, "form-components--telephone-field-locale-value": I18n.locale, action: "click@document->form-components--telephone-field#clickOutside"} do %>
    <div class="<%= wrapper_classes %>">
      <button type="button" class="flex shrink-0 items-center gap-2 rounded-l-md border-r border-gray-300 py-1.5 pr-2.5 pl-3 text-base text-gray-900 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary-600 disabled:cursor-not-allowed sm:text-sm/6 auto-dark:border-white/10 auto-dark:text-white" aria-haspopup="listbox" aria-expanded="false" aria-label="<%= country_label %>" <%= "disabled" if html_options[:disabled] %> data-form-components--telephone-field-target="toggle" data-action="form-components--telephone-field#toggle keydown->form-components--telephone-field#toggleKeydown">
        <span class="fi fi-<%= selected_country %> rounded-xs" data-form-components--telephone-field-target="flag"></span>
        <span data-form-components--telephone-field-target="code">+<%= calling_code %></span>
        <span class="fas fa-chevron-down text-xs text-gray-400" aria-hidden="true"></span>
      </button>
      <%= hidden_input %>
      <%= input %>
      <% if has_error? %>
        <div class="fas fa-circle-exclamation pointer-events-none mr-3 size-5 shrink-0 self-center text-red-500 sm:size-4"></div>
      <% end %>
    </div>
    <div class="absolute left-0 z-20 mt-2 w-full rounded-xl bg-white p-2 shadow-lg outline outline-1 outline-black/5 auto-dark:bg-gray-800 auto-dark:outline-white/10" hidden data-form-components--telephone-field-target="menu">
      <div class="grid grid-cols-1">
        <input type="text" class="col-start-1 row-start-1 block w-full rounded-md border-0 bg-white py-1.5 pr-3 pl-9 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-1 focus:outline-primary-600 focus:ring-0 sm:text-sm/6 auto-dark:bg-white/5 auto-dark:text-white auto-dark:outline-white/10 auto-dark:placeholder:text-gray-500" placeholder="<%= search_placeholder %>" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="true" aria-controls="<%= tag_id %>_countries" aria-label="<%= search_placeholder %>" data-form-components--telephone-field-target="search" data-action="input->form-components--telephone-field#filter keydown->form-components--telephone-field#searchKeydown">
        <span class="fas fa-magnifying-glass pointer-events-none col-start-1 row-start-1 ml-3 size-4 self-center text-gray-400" aria-hidden="true"></span>
      </div>
      <ul id="<%= tag_id %>_countries" role="listbox" aria-label="<%= country_label %>" class="mt-2 max-h-72 overflow-y-auto" data-form-components--telephone-field-target="list" data-action="click->form-components--telephone-field#pick mousemove->form-components--telephone-field#hover"></ul>
    </div>
  <% end %>
  <% if description.present? %>
    <p class="mt-2 text-sm text-gray-500 auto-dark:text-gray-400" id="<%= tag_id %>_description"><%= description %></p>
  <% end %>
  <% if has_error? %>
    <p class="mt-2 text-sm text-red-600 auto-dark:text-red-400" id="<%= tag_id %>_error"><%= all_errors.join(", ") %></p>
  <% end %>
</div>
