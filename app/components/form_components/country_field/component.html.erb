<div class="form-component">
  <% if label != false || corner_hint.present? %>
    <div class="flex justify-between">
      <%= field_label %>
      <span class="text-sm/6 text-gray-500 auto-dark:text-gray-400"><%= corner_hint %></span>
    </div>
  <% end %>
  <%= tag.div class: class_names("relative", "mt-2" => !grouped?), data: {controller: "form-components--country-field", "form-components--country-field-countries-value": COUNTRIES.map { |iso| [iso, nil] }.to_json, "form-components--country-field-priority-value": priority_countries.to_json, "form-components--country-field-country-value": country.to_s, "form-components--country-field-placeholder-value": placeholder, "form-components--country-field-locale-value": I18n.locale, action: "click@document->form-components--country-field#clickOutside"} do %>
    <%= hidden_input %>
    <%= tag.button(**toggle_attributes) do %>
      <span class="<%= country ? "fi fi-#{country} rounded-xs" : "hidden" %>" data-form-components--country-field-target="flag"></span>
      <span id="<%= tag_id %>_value" class="<%= class_names("grow truncate", "text-gray-500 auto-dark:text-gray-400" => country.nil?) %>" data-form-components--country-field-target="name"><%= country&.upcase || placeholder %></span>
      <span class="fas fa-chevron-down text-xs text-gray-400" aria-hidden="true"></span>
    <% end %>
    <% if clearable? %>
      <button type="button" class="absolute inset-y-0 right-8 flex items-center px-1 text-gray-400 hover:text-gray-600 auto-dark:hover:text-gray-300" title="<%= clear_label %>" aria-label="<%= clear_label %>" <%= "hidden" unless country %> data-form-components--country-field-target="clear" data-action="form-components--country-field#clear">
        <span class="fas fa-xmark text-sm" aria-hidden="true"></span>
      </button>
    <% end %>
    <div class="absolute left-0 z-20 mt-2 w-full rounded-xl bg-white p-2 shadow-lg outline outline-1 outline-black/5 auto-dark:bg-gray-800 auto-dark:outline-white/10" hidden data-form-components--country-field-target="menu">
      <div class="grid grid-cols-1">
        <input type="text" class="col-start-1 row-start-1 block w-full rounded-md border-0 bg-white py-1.5 pr-3 pl-9 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-1 focus:outline-primary-600 focus:ring-0 sm:text-sm/6 auto-dark:bg-white/5 auto-dark:text-white auto-dark:outline-white/10 auto-dark:placeholder:text-gray-400" placeholder="<%= search_placeholder %>" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="true" aria-controls="<%= tag_id %>_countries" aria-label="<%= search_placeholder %>" data-form-components--country-field-target="search" data-action="input->form-components--country-field#filter keydown->form-components--country-field#searchKeydown">
        <span class="fas fa-magnifying-glass pointer-events-none col-start-1 row-start-1 ml-3 size-4 self-center text-gray-400" aria-hidden="true"></span>
      </div>
      <ul id="<%= tag_id %>_countries" role="listbox" aria-label="<%= human_attribute_name %>" class="mt-2 max-h-72 overflow-y-auto" data-form-components--country-field-target="list" data-action="click->form-components--country-field#pick mousemove->form-components--country-field#hover"></ul>
    </div>
  <% end %>
  <% unless grouped? %>
    <% if description.present? %>
      <p class="mt-2 text-sm text-gray-500 auto-dark:text-gray-400" id="<%= tag_id %>_description"><%= description %></p>
    <% end %>
    <% if has_error? %>
      <p class="mt-2 text-sm text-red-600 auto-dark:text-red-400" id="<%= tag_id %>_error"><%= all_errors.join(", ") %></p>
    <% end %>
  <% end %>
</div>
