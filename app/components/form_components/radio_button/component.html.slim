.form-component.relative.flex.items-start
  .flex.h-6.items-center
    = input
  .ml-3.text-sm/6
    - if label != false
      div.flex.justify-between
        = field_label(input_id, value: tag_value)
    - if description.present?
      label.text-gray-500.auto-dark:text-gray-400 for=input_id id=input_id+"_description"
        = description
    - if has_error?
      p id=input_id+"_error" class="mt-2 text-sm text-red-600 auto-dark:text-red-400" = all_errors.join(", ")
