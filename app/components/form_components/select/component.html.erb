<div class="form-component">
  <%= field_label %>
  <% if depends_on_fields.any? %>
    <div class="<%= class_names("mt-2" => !grouped?) %>" data-controller="form-components--depends-on" data-form-components--depends-on-fields-value="<%= depends_on_fields.to_json %>"><%= input %></div>
  <% else %>
    <div class="<%= class_names("mt-2" => !grouped?) %>"><%= input %></div>
  <% end %>
  <% unless grouped? %>
    <% if description.present? %>
      <p class="mt-2 text-sm text-gray-500 auto-dark:text-gray-400" id="<%= tag_id %>_description"><%= description %></p>
    <% end %>
    <% if has_error? %>
      <p class="mt-2 text-sm text-red-600 auto-dark:text-red-400" id="<%= tag_id %>_error"><%= all_errors.join(", ") %></p>
    <% end %>
  <% end %>
</div>
