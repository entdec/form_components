<div class="form-component">
  <% if label != false || corner_hint.present? %>
    <div class="flex justify-between">
      <%= field_label %>
      <span class="text-sm/6 text-gray-500 auto-dark:text-gray-400"><%= corner_hint %></span>
    </div>
  <% end %>
  <%= tag.div class: class_names("mt-2", wrapper_classes), data: {controller: "form-components--money-field", "form-components--money-field-symbols-value": symbols.to_json} do %>
    <% if symbols.any? %>
      <span class="shrink-0 select-none pl-3 text-base text-gray-500 sm:text-sm/6 auto-dark:text-gray-400" aria-hidden="true" data-form-components--money-field-target="symbol"><%= symbol %></span>
    <% end %>
    <%= input %>
    <% if has_error? %>
      <div class="fas fa-circle-exclamation pointer-events-none size-5 shrink-0 text-red-500 sm:size-4" aria-hidden="true"></div>
    <% end %>
    <%= currency_select %>
  <% end %>
  <% if description.present? %>
    <p class="mt-2 text-sm text-gray-500 auto-dark:text-gray-400" id="<%= tag_id %>_description"><%= description %></p>
  <% end %>
  <% if has_error? %>
    <p class="mt-2 text-sm text-red-600 auto-dark:text-red-400" id="<%= tag_id %>_error"><%= all_errors.join(", ") %></p>
  <% end %>
</div>
