<%= tag.div class: "form-component", data: controller_data do %>
  <% if label != false || corner_hint.present? %>
    <div class="flex justify-between">
      <%= field_label %>
      <span class="text-sm/6 text-gray-500 auto-dark:text-gray-400"><%= corner_hint %></span>
    </div>
  <% end %>
  <div class="<%= wrapper_classes %>">
    <% if toolbar.any? %>
      <div class="flex flex-wrap items-center gap-1 border-b border-gray-200 px-2 py-1.5 auto-dark:border-white/10" role="toolbar" aria-controls="<%= tag_id %>_editor" data-form-components--rich-text-area-target="toolbar">
        <% toolbar_groups.each_with_index do |group, index| %>
          <% if index > 0 %>
            <span class="mx-1 h-5 w-px bg-gray-200 auto-dark:bg-white/10" aria-hidden="true"></span>
          <% end %>
          <% group.each do |name| %>
            <% if name == :heading %>
              <select class="h-7 rounded-md border-0 bg-transparent py-0 pr-7 pl-2 text-sm text-gray-700 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:outline-primary-600 focus:ring-0 auto-dark:bg-gray-800 auto-dark:text-gray-200 auto-dark:outline-white/10" aria-label="<%= title(:heading) %>" data-form-components--rich-text-area-target="heading" data-action="form-components--rich-text-area#heading">
                <option value="0"><%= paragraph_label %></option>
                <% HEADING_LEVELS.each do |level| %>
                  <option value="<%= level %>"><%= heading_label(level) %></option>
                <% end %>
              </select>
            <% else %>
              <button type="button" class="<%= button_classes %>" title="<%= title(name) %>" aria-label="<%= title(name) %>" data-command="<%= name %>" data-form-components--rich-text-area-target="button" data-action="mousedown->form-components--rich-text-area#keepFocus form-components--rich-text-area#run">
                <span class="<%= BUTTONS[name] %>" aria-hidden="true"></span>
              </button>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <% if toolbar.include?(:link) %>
      <div class="absolute top-11 left-2 z-20 flex w-80 max-w-[calc(100%-1rem)] items-center gap-2 rounded-lg bg-white p-2 shadow-lg outline outline-1 outline-black/5 auto-dark:bg-gray-800 auto-dark:outline-white/10" hidden data-form-components--rich-text-area-target="linkMenu">
        <input type="url" class="block min-w-0 grow rounded-md border-0 bg-white px-2 py-1 text-sm text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-1 focus:outline-primary-600 focus:ring-0 auto-dark:bg-white/5 auto-dark:text-white auto-dark:outline-white/10" placeholder="https://" aria-label="<%= link_label %>" data-form-components--rich-text-area-target="linkInput" data-action="keydown->form-components--rich-text-area#linkKeydown">
        <button type="button" class="rounded-md bg-primary-600 px-2.5 py-1 text-sm font-semibold text-white hover:bg-primary-500" data-action="form-components--rich-text-area#applyLink"><%= apply_label %></button>
        <button type="button" class="<%= button_classes %>" title="<%= remove_link_label %>" aria-label="<%= remove_link_label %>" data-action="form-components--rich-text-area#removeLink">
          <span class="fas fa-link-slash" aria-hidden="true"></span>
        </button>
      </div>
    <% end %>
    <% if toolbar.include?(:image) %>
      <input type="file" accept="image/*" multiple hidden data-form-components--rich-text-area-target="file" data-action="form-components--rich-text-area#pick">
    <% end %>
    <div data-form-components--rich-text-area-target="editor"></div>
    <%= input %>
    <% if has_error? %>
      <div class="fas fa-circle-exclamation pointer-events-none absolute right-3 bottom-3 size-5 text-red-500 sm:size-4"></div>
    <% end %>
  </div>
  <% if description.present? %>
    <p class="mt-2 text-sm text-gray-500 auto-dark:text-gray-400" id="<%= tag_id %>_description"><%= description %></p>
  <% end %>
  <% if has_error? %>
    <p class="mt-2 text-sm text-red-600 auto-dark:text-red-400" id="<%= tag_id %>_error"><%= all_errors.join(", ") %></p>
  <% end %>
<% end %>
