<%= tag.div class: "form-component", data: controller_data do %>
  <% if label != false || corner_hint.present? %>
    <div class="flex justify-between">
      <%= field_label %>
      <span class="text-sm/6 text-gray-500 auto-dark:text-gray-400"><%= corner_hint %></span>
    </div>
  <% end %>
  <div class="<%= wrapper_classes %>">
    <% if toolbar.any? %>
      <%# One row: the groups that don't fit (from the end, not the first) go into the More menu, see the controller.
          Its width is its field's, not its buttons' (contain: inline-size), so a narrow field doesn't widen for them %>
      <div class="flex flex-nowrap items-center [contain:inline-size] gap-0.5 border-b border-gray-200 px-2 py-1.5 auto-dark:border-white/10" role="toolbar" aria-label="<%= toolbar_label %>" aria-controls="<%= tag_id %>_editor" data-form-components--rich-text-area-target="toolbar" data-action="keydown->form-components--rich-text-area#toolbarKeydown">
        <% toolbar_groups.each_with_index do |group, index| %>
          <div class="flex shrink-0 items-center gap-0.5" data-group="<%= index %>" data-form-components--rich-text-area-target="group">
            <% if index > 0 %>
              <span class="mx-1.5 h-6 w-px bg-gray-200 auto-dark:bg-white/10" aria-hidden="true"></span>
            <% end %>
            <% group.each do |name| %>
              <% if name == :heading %>
                <div class="relative">
                  <button type="button" class="<%= button_classes %>" title="<%= title(:heading) %>" aria-label="<%= title(:heading) %>" aria-expanded="false" aria-controls="<%= tag_id %>_headings" data-form-components--rich-text-area-target="headingToggle" data-action="mousedown->form-components--rich-text-area#keepFocus form-components--rich-text-area#toggleHeadings">
                    <%= icon("heading") %><%= icon("chevron-down", "-ml-1 size-3 shrink-0") %>
                  </button>
                  <div id="<%= tag_id %>_headings" class="<%= menu_classes %> left-0 min-w-40" hidden data-form-components--rich-text-area-target="headingMenu" data-action="keydown->form-components--rich-text-area#headingMenuKeydown">
                    <% [0, *HEADING_LEVELS].each do |level| %>
                      <button type="button" class="<%= menu_item_classes %>" aria-pressed="false" data-level="<%= level %>" data-form-components--rich-text-area-target="headingItem" data-action="mousedown->form-components--rich-text-area#keepFocus form-components--rich-text-area#heading">
                        <%= icon(heading_icon(level), "size-4 shrink-0 text-gray-500 auto-dark:text-gray-400") %><%= level.zero? ? paragraph_label : heading_label(level) %>
                      </button>
                    <% end %>
                  </div>
                </div>
              <% elsif name == :image %>
                <button type="button" class="<%= button_classes %> pr-2" title="<%= title(:image) %>" data-command="image" data-form-components--rich-text-area-target="button" data-action="mousedown->form-components--rich-text-area#keepFocus form-components--rich-text-area#run">
                  <%= icon(BUTTONS[:image]) %><span><%= add_image_label %><span class="sr-only"> <%= title(:image).downcase %></span></span>
                </button>
              <% else %>
                <button type="button" class="<%= button_classes %>" title="<%= title(name) %>" aria-label="<%= title(name) %>" data-command="<%= name %>" data-form-components--rich-text-area-target="button" data-action="mousedown->form-components--rich-text-area#keepFocus form-components--rich-text-area#run">
                  <%= icon(BUTTONS[name]) %>
                </button>
              <% end %>
            <% end %>
          </div>
        <% end %>
        <%# The groups' buttons that don't fit, each with its name; the heading menu's group always fits, it's first %>
        <div class="relative ml-auto shrink-0" hidden data-form-components--rich-text-area-target="more">
          <button type="button" class="<%= button_classes %>" title="<%= more_label %>" aria-label="<%= more_label %>" aria-expanded="false" aria-controls="<%= tag_id %>_more" data-form-components--rich-text-area-target="moreToggle" data-action="mousedown->form-components--rich-text-area#keepFocus form-components--rich-text-area#toggleMore">
            <%= icon("ellipsis") %>
          </button>
          <div id="<%= tag_id %>_more" class="<%= menu_classes %> right-0 min-w-48" hidden data-form-components--rich-text-area-target="moreMenu" data-action="keydown->form-components--rich-text-area#moreMenuKeydown">
            <% toolbar_groups.each_with_index do |group, index| %>
              <% next if group.include?(:heading) %>
              <div class="flex flex-col" data-group="<%= index %>" data-form-components--rich-text-area-target="moreGroup">
                <span class="mx-2.5 my-1 h-px bg-gray-200 auto-dark:bg-white/10" aria-hidden="true" data-more-separator></span>
                <% group.each do |name| %>
                  <button type="button" class="<%= menu_item_classes %>" data-command="<%= name %>" data-form-components--rich-text-area-target="button moreItem" data-action="mousedown->form-components--rich-text-area#keepFocus form-components--rich-text-area#run">
                    <%= icon(BUTTONS[name], "size-4 shrink-0 text-gray-500 auto-dark:text-gray-400") %><%= title(name) %>
                  </button>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
    <% if toolbar.include?(:link) %>
      <div class="absolute top-12 left-2 z-20 flex w-80 max-w-[calc(100%-1rem)] items-center gap-2 rounded-xl bg-white p-2 shadow-lg outline outline-1 outline-black/5 auto-dark:bg-gray-800 auto-dark:outline-white/10" hidden data-form-components--rich-text-area-target="linkMenu">
        <input type="url" class="block min-w-0 grow rounded-md border-0 bg-white px-2 py-1 text-sm text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-1 focus:outline-primary-600 focus:ring-0 auto-dark:bg-white/5 auto-dark:text-white auto-dark:outline-white/10" placeholder="https://" aria-label="<%= link_label %>" data-form-components--rich-text-area-target="linkInput" data-action="keydown->form-components--rich-text-area#linkKeydown">
        <button type="button" class="rounded-md bg-primary-600 px-2.5 py-1 text-sm font-semibold text-white hover:bg-primary-500" data-action="form-components--rich-text-area#applyLink"><%= apply_label %></button>
        <button type="button" class="<%= button_classes %>" title="<%= remove_link_label %>" aria-label="<%= remove_link_label %>" data-action="form-components--rich-text-area#removeLink">
          <%= icon("unlink") %>
        </button>
      </div>
    <% end %>
    <% if toolbar.include?(:image) %>
      <input type="file" accept="image/*" multiple hidden data-form-components--rich-text-area-target="file" data-action="form-components--rich-text-area#pick">
    <% end %>
    <div data-form-components--rich-text-area-target="editor"></div>
    <%= input %>
    <% if has_error? %>
      <div class="fas fa-circle-exclamation pointer-events-none absolute right-3 bottom-3 size-5 text-red-500 sm:size-4" aria-hidden="true"></div>
    <% end %>
  </div>
  <% if description.present? %>
    <p class="mt-2 text-sm text-gray-500 auto-dark:text-gray-400" id="<%= tag_id %>_description"><%= description %></p>
  <% end %>
  <% if has_error? %>
    <p class="mt-2 text-sm text-red-600 auto-dark:text-red-400" id="<%= tag_id %>_error"><%= all_errors.join(", ") %></p>
  <% end %>
<% end %>
