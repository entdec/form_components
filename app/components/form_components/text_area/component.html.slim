.form-component
  - if label != false || corner_hint.present?
    div.flex.justify-between
      = field_label
      span.text-sm/6.text-gray-500.auto-dark:text-gray-400
        = corner_hint
  div.mt-2 class="grid grid-cols-1"
    = input
    - if has_error?
      .fas.fa-circle-exclamation class="pointer-events-none col-start-1 row-start-1 mr-3 size-5 self-center justify-self-end text-red-500 sm:size-4"
  - if description.present?
    p id=tag_id+"_description" class="mt-2 text-sm text-gray-500 auto-dark:text-gray-400" = description
  - if has_error?
    p id=tag_id+"_error" class="mt-2 text-sm text-red-600 auto-dark:text-red-400" = all_errors.join(", ")
